<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="fw-bold text-dark" data-testid="text-page-title"><i class="bi bi-calendar-check text-primary me-2"></i> Book Appointment</h3>
  <a href="/booking/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-testid="link-logout">Logout</a>
</div>


<div class="row g-4 mb-4">
  <div class="col-md-6">
    <div class="card shadow-sm h-100 border-0">
      <div class="card-body">
        <h6 class="text-muted fw-bold text-uppercase mb-3" style="letter-spacing: 0.05em;">Student Information</h6>
        <div class="d-flex flex-column gap-2">
          <div class="d-flex"><div class="text-muted" style="width:100px"><i class="bi bi-person me-1"></i> Name:</div><div data-testid="text-student-name" class="fw-medium text-dark"><%= student.studentName %><% if (student.nickname) { %> <span class="text-muted">(<%= student.nickname %>)</span><% } %></div></div>
          <div class="d-flex"><div class="text-muted" style="width:100px"><i class="bi bi-hash me-1"></i> ID:</div><div data-testid="text-student-id" class="text-dark"><%= student.studentId %></div></div>
          <div class="d-flex"><div class="text-muted" style="width:100px"><i class="bi bi-book me-1"></i> Class:</div><div data-testid="text-student-class" class="text-dark"><%= student.pcClass %></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card shadow-sm h-100 border-0">
      <div class="card-body">
        <h6 class="text-muted fw-bold text-uppercase mb-3" style="letter-spacing: 0.05em;">Assigned Teacher</h6>
        <div class="d-flex flex-column gap-2">
          <div class="d-flex"><div class="text-muted" style="width:100px"><i class="bi bi-person-video3 me-1"></i> Teacher:</div><div data-testid="text-teacher-name" class="fw-medium text-dark"><%= student.teacherName %><% if (student.teacherNickname) { %> <span class="text-muted">(<%= student.teacherNickname %>)</span><% } %></div></div>
          <% if (student.teacherRoom) { %><div class="d-flex"><div class="text-muted" style="width:100px"><i class="bi bi-geo-alt me-1"></i> Room:</div><div data-testid="text-teacher-room" class="text-dark"><%= student.teacherRoom %></div></div><% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (existingBookings && existingBookings.length > 0) { %>
  <div class="card shadow-sm mb-4 border-success">
    <div class="card-header bg-success text-white">
      <h6 class="mb-0">Your Confirmed Bookings</h6>
    </div>
    <div class="card-body p-0">
      <table class="table table-sm mb-0">
        <thead class="table-light">
          <tr><th>Day</th><th>Date</th><th>Slot</th><th>Time</th><th></th></tr>
        </thead>
        <tbody>
          <% existingBookings.forEach(b => { %>
            <tr data-testid="row-existing-booking-<%= b.BookingID %>">
              <td><%= b.DayLabel %></td>
              <td><%= b.MeetingDate ? new Date(b.MeetingDate).toLocaleDateString() : '' %></td>
              <td><strong><%= b.ScheduleCode %></strong></td>
              <td><%= b.StartTime ? b.StartTime.substring(0,5) : '' %> – <%= b.EndTime ? b.EndTime.substring(0,5) : '' %></td>
              <td>
                <a href="/booking/view/<%= b.BookingID %>" class="btn btn-outline-success btn-sm rounded-pill px-3" data-testid="link-view-booking-<%= b.BookingID %>">
                  <i class="bi bi-eye"></i> View
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%
  var allDatesBooked = existingBookings && meetingDates && meetingDates.length > 0 &&
    meetingDates.every(function(d) { return existingBookings.some(function(b) { return b.MeetingDateID === d.DateID; }); });
%>
<% if (!term) { %>
  <div class="alert alert-warning">No active booking term found. Please contact the school.</div>
<% } else if (allDatesBooked) { %>
  <div class="alert alert-info" data-testid="alert-all-booked">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-2" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.071 1.05l-3.992 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/></svg>
    You have confirmed bookings for all available meeting dates. To make changes, please contact the school.
  </div>
<% } else { %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header border-0 bg-transparent pt-4 pb-0">
      <h6 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 0.05em;"><i class="bi bi-calendar3 me-2 text-primary"></i> Select Meeting Date</h6>
    </div>
    <div class="card-body">
      <form method="GET" action="/booking/select" data-testid="form-select-date">
        <div class="row g-3 align-items-end">
          <div class="col-md-8">
            <select name="dateId" class="form-select form-select-lg shadow-sm border-0 bg-light" data-testid="select-date">
              <option value="">— Select a Meeting Date —</option>
              <% meetingDates.forEach(d => { %>
                <%
                  const hasExisting = existingBookings && existingBookings.some(b => b.MeetingDateID === d.DateID);
                %>
                <option value="<%= d.DateID %>"
                        <%= selectedDateId === d.DateID ? 'selected' : '' %>
                        <%= d.slotCount === 0 ? 'disabled' : '' %>>
                  <%= d.DayLabel %> — <%= new Date(d.MeetingDate).toLocaleDateString() %><%= d.slotCount === 0 ? ' [No Slots]' : '' %><%= hasExisting ? ' ✓ Booked' : '' %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm" data-testid="button-load-slots"><i class="bi bi-search me-1"></i> Load Slots</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <% if (selectedDateId && slots.length > 0) { %>
    <%
      const hasBookingForDate = existingBookings && existingBookings.some(b => b.MeetingDateID === selectedDateId);
      const availableSlots = slots.filter(s => s.effectiveStatus === 'available');
      const unavailableSlots = slots.filter(s => s.effectiveStatus !== 'available');
    %>

    <% if (hasBookingForDate) { %>
      <div class="alert alert-info">
        You already have a confirmed booking for this meeting date. To change your booking, please contact the school administration.
      </div>
    <% } %>

    <div class="card shadow-sm mb-4">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Available Time Slots</h6>
        <div>
          <span class="badge bg-success me-1"><%= availableSlots.length %> Available</span>
          <span class="badge bg-primary"><%= unavailableSlots.length %> Booked</span>
        </div>
      </div>
      <div class="card-body">
        <% if (!hasBookingForDate && availableSlots.length > 0) { %>
          <form method="POST" action="/booking/confirm" data-testid="form-confirm-booking"
                    data-confirm="Are you sure you want to confirm this booking?" data-confirm-btn="Confirm">
            <input type="hidden" name="meetingDateId" value="<%= selectedDateId %>">
            <div class="row g-3 mb-4">
              <% slots.forEach(slot => { %>
                <div class="col-6 col-md-4 col-lg-3">
                  <div class="card h-100 border-0 shadow-sm <%= slot.effectiveStatus === 'available' ? 'slot-available' : '' %>"
                       data-testid="slot-card-<%= slot.SlotID %>"
                       title="<%= slot.effectiveStatus === 'available' ? 'Available' : 'Booked' %>"
                       style="<%= slot.effectiveStatus === 'available' ? 'cursor:pointer' : 'opacity:0.6; background-color:#f1f5f9' %>"
                       <% if (slot.effectiveStatus === 'available') { %>
                         onclick="document.getElementById('slot_<%= slot.SlotID %>').checked=true; document.querySelectorAll('.slot-available').forEach(c=>c.classList.remove('selected')); this.classList.add('selected');"
                       <% } %>>
                    <div class="card-body p-3 text-center d-flex flex-column justify-content-center">
                      <strong class="fs-5 mb-1 text-dark"><%= slot.ScheduleCode %></strong>
                      <div class="text-muted mb-2"><i class="bi bi-clock me-1"></i> <%= slot.StartTime.substring(0,5) %> – <%= slot.EndTime.substring(0,5) %></div>
                      <% if (slot.effectiveStatus === 'available') { %>
                        <input class="form-check-input mt-1" type="radio" name="slotId" value="<%= slot.SlotID %>"
                               id="slot_<%= slot.SlotID %>" required data-testid="radio-slot-<%= slot.SlotID %>" style="display:none">
                        <div><span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Available</span></div>
                      <% } else { %>
                        <div><span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i> Booked</span></div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>

            <div class="border-top pt-3">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label">Translator Required?</label>
                  <select name="translatorRequired" class="form-select" data-testid="select-translator" id="parentTranslatorSelect">
                    <option value="0">No</option>
                    <option value="1">Yes</option>
                  </select>
                </div>
                <div class="col-md-4" id="parentLanguageField" style="display:none;">
                  <label class="form-label">Language</label>
                  <% if (typeof translatorLanguages !== 'undefined' && translatorLanguages.length > 0) { %>
                    <select name="translatorLanguage" class="form-select" data-testid="select-language">
                      <option value="">-- Select Language --</option>
                      <% translatorLanguages.forEach(function(lang) { %>
                        <option value="<%= lang %>"><%= lang %></option>
                      <% }); %>
                    </select>
                  <% } else { %>
                    <input type="text" name="translatorLanguage" class="form-control" placeholder="e.g. Thai, Chinese" data-testid="input-language">
                  <% } %>
                </div>
                <div class="col-md-3 ms-auto">
                  <button type="submit" class="btn btn-primary btn-lg w-100" data-testid="button-confirm-booking">
                    Confirm Booking
                  </button>
                </div>
              </div>
            </div>
          </form>
        <% } else if (!hasBookingForDate) { %>
          <div class="row g-2">
            <% slots.forEach(slot => { %>
              <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100" style="opacity:0.7" data-testid="slot-card-<%= slot.SlotID %>">
                  <div class="card-body p-2 text-center">
                    <strong><%= slot.ScheduleCode %></strong><br>
                    <small><%= slot.StartTime.substring(0,5) %> – <%= slot.EndTime.substring(0,5) %></small><br>
                    <span class="badge bg-primary mt-1">Booked</span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="alert alert-warning mt-3 mb-0">No available slots for your teacher on this date.</div>
        <% } else { %>
          <div class="row g-2">
            <% slots.forEach(slot => { %>
              <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100" style="opacity:0.7" title="Booked">
                  <div class="card-body p-2 text-center">
                    <strong><%= slot.ScheduleCode %></strong><br>
                    <small><%= slot.StartTime.substring(0,5) %> – <%= slot.EndTime.substring(0,5) %></small><br>
                    <% if (slot.effectiveStatus === 'available') { %>
                      <span class="badge bg-success mt-1">Available</span>
                    <% } else { %>
                      <span class="badge bg-primary mt-1">Booked</span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } else if (selectedDateId) { %>
    <div class="alert alert-warning">No time slots found for this meeting date.</div>
  <% } %>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var sel = document.getElementById('parentTranslatorSelect');
    var field = document.getElementById('parentLanguageField');
    if (sel && field) {
      sel.addEventListener('change', function() {
        field.style.display = this.value === '1' ? '' : 'none';
      });
    }
  });
</script>
