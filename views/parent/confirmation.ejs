<div class="row justify-content-center mt-4">
  <div class="col-md-8 col-lg-7">
    <div class="card shadow-sm border-success">
      <div class="card-header bg-success text-white text-center">
        <h4 class="mb-0" data-testid="text-page-title">Booking Confirmed!</h4>
      </div>
      <div class="card-body p-4">
        <div class="text-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-success"
            viewBox="0 0 16 16">
            <path
              d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
          </svg>
        </div>

        <table class="table table-sm" data-testid="table-confirmation">
          <tbody>
            <tr>
              <td class="text-muted fw-bold" style="width:40%">Student Name</td>
              <td data-testid="text-confirm-student">
                <%= student.studentName %>
              </td>
            </tr>
            <tr>
              <td class="text-muted fw-bold">Student ID</td>
              <td data-testid="text-confirm-student-id">
                <%= student.studentId %>
              </td>
            </tr>
            <tr>
              <td class="text-muted fw-bold">Class</td>
              <td>
                <%= student.pcClass %>
              </td>
            </tr>
            <tr>
              <td class="text-muted fw-bold">Teacher</td>
              <td data-testid="text-confirm-teacher">
                <%= student.teacherName %>
                  <% if (student.teacherNickname) { %> (<%= student.teacherNickname %>)<% } %>
              </td>
            </tr>
            <% if (student.teacherRoom) { %>
              <tr>
                <td class="text-muted fw-bold">Meeting Day</td>
                <td data-testid="text-confirm-day">
                  <%= booking.DayLabel %> — <%= booking.MeetingDate ? new Date(booking.MeetingDate).toLocaleDateString('en-GB')
                      : '' %>
                </td>
              </tr>
              <% } %>
                <tr>
                  <td class="text-muted fw-bold">Venue</td>
                  <td><%= booking.teacherRoom %></td>
                </tr>
                <tr>
                  <td class="text-muted fw-bold">Schedule Code</td>
                  <td data-testid="text-confirm-schedule"><strong class="fs-5">
                      <%= booking.ScheduleCode %>
                    </strong></td>
                </tr>
                <tr>
                  <td class="text-muted fw-bold">Time</td>
                  <td data-testid="text-confirm-time">
                    <%= booking.StartTime ? booking.StartTime.substring(0,5) : '' %> – <%= booking.EndTime ?
                        booking.EndTime.substring(0,5) : '' %>
                  </td>
                </tr>
                <tr>
                  <td class="text-muted fw-bold">Translator</td>
                  <td>
                    <% if (booking.TranslatorRequired) { %>
                      <span class="badge bg-info">
                        <%= booking.TranslatorLanguage || 'Required' %>
                      </span>
                      <% } else { %>
                        None
                        <% } %>
                  </td>
                </tr>
                <tr>
                  <td class="text-muted fw-bold">Status</td>
                  <td><span class="badge bg-success" data-testid="badge-confirm-status">Confirmed</span></td>
                </tr>
          </tbody>
        </table>

        <div class="alert alert-info mt-3 mb-0" data-testid="text-notice">
          <strong>Important: <i>PGJ is Online Meeting </i></strong>
          <br>This booking cannot be changed or cancelled. If you need to make changes, please
          contact the school administration.
        </div>
      </div>
    </div>

    <div class="card shadow-sm mt-4">
      <div class="card-header bg-light">
        <h6 class="mb-0">Download & Email Confirmation</h6>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <h6 class="mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                  class="me-1 text-danger" viewBox="0 0 16 16">
                  <path
                    d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z" />
                </svg>
                PDF Confirmation
              </h6>
              <p class="text-muted small mb-3">Download a PDF copy of your booking confirmation.</p>
              <a href="/booking/download-pdf/<%= booking.BookingID %>" class="btn btn-outline-danger w-100"
                data-testid="button-download-pdf" id="btnDownloadPdf">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1"
                  viewBox="0 0 16 16">
                  <path
                    d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
                  <path
                    d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z" />
                </svg>
                Download PDF
              </a>
            </div>
          </div>

          <div class="col-md-6">
            <div class="border rounded p-3 h-100">
              <h6 class="mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                  class="me-1 text-primary" viewBox="0 0 16 16">
                  <path
                    d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z" />
                </svg>
                Email Confirmation
              </h6>
              <p class="text-muted small mb-2">Send a confirmation email with PDF attached.</p>
              <div class="mb-2">
                <input type="email" class="form-control form-control-sm" id="emailInput"
                  placeholder="Enter email address" required
                  value="<%= typeof studentEmail !== 'undefined' ? studentEmail : '' %>" data-testid="input-email">
              </div>
              <div id="emailAlert" style="display:none;" class="mb-2"></div>
              <button type="button" class="btn btn-primary w-100" id="btnSendEmail" data-testid="button-send-email"
                data-booking-id="<%= booking.BookingID %>">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1"
                  viewBox="0 0 16 16">
                  <path
                    d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.5.5 0 0 1-.928.086l-2.702-5.404L1.5 7.5a.5.5 0 0 1 .086-.928L16.133.253a.5.5 0 0 1 .267-.107M6.636 10.07l2.761 5.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z" />
                </svg>
                <span id="emailBtnText">Send Confirmation Email</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="text-center mt-4 mb-4">
      <a href="/booking/logout" class="btn btn-outline-secondary" data-testid="link-logout">Logout</a>
    </div>
  </div>
</div>

<div class="modal fade" id="loadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content text-center p-4">
      <div class="spinner-border text-primary mx-auto mb-3" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
      <p class="mb-0" id="loadingText">Sending email...</p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var btnSend = document.getElementById('btnSendEmail');
    var emailInput = document.getElementById('emailInput');
    var emailAlert = document.getElementById('emailAlert');
    var emailBtnText = document.getElementById('emailBtnText');
    var loadingModal = new bootstrap.Modal(document.getElementById('loadingModal'));
    var loadingText = document.getElementById('loadingText');

    function showAlert(msg, type) {
      emailAlert.innerHTML = '<div class="alert alert-' + type + ' alert-sm py-1 px-2 small mb-0">' + msg + '</div>';
      emailAlert.style.display = 'block';
    }

    btnSend.addEventListener('click', function () {
      var email = emailInput.value.trim();
      if (!email) {
        showAlert('Please enter an email address.', 'danger');
        emailInput.focus();
        return;
      }
      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showAlert('Please enter a valid email address.', 'danger');
        emailInput.focus();
        return;
      }

      btnSend.disabled = true;
      emailBtnText.textContent = 'Sending...';
      emailAlert.style.display = 'none';
      loadingText.textContent = 'Sending confirmation email...';
      loadingModal.show();

      var bookingId = btnSend.getAttribute('data-booking-id');

      fetch('/booking/send-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bookingId: bookingId, email: email })
      })
        .then(function (r) { return r.json(); })
        .then(function (result) {
          loadingModal.hide();
          if (result.success) {
            showAlert('Email sent successfully to ' + email, 'success');
            emailBtnText.textContent = 'Email Sent!';
            setTimeout(function () {
              btnSend.disabled = false;
              emailBtnText.textContent = 'Send Confirmation Email';
            }, 5000);
          } else {
            showAlert(result.error || 'Failed to send email.', 'danger');
            btnSend.disabled = false;
            emailBtnText.textContent = 'Send Confirmation Email';
          }
        })
        .catch(function (err) {
          loadingModal.hide();
          showAlert('Network error. Please try again.', 'danger');
          btnSend.disabled = false;
          emailBtnText.textContent = 'Send Confirmation Email';
        });
    });
  });
</script>