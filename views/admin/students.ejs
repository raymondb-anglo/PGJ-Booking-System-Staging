<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0 text-dark fw-bold" data-testid="text-page-title">Students</h1>
  <div class="d-flex gap-2">
    <a href="/admin/students/import" class="btn btn-outline-secondary d-flex align-items-center gap-2" data-testid="link-import-students">
      <i class="bi bi-file-earmark-arrow-up"></i> Import CSV
    </a>
    <a href="/admin/students/create" class="btn btn-primary d-flex align-items-center gap-2" data-testid="link-create-student">
      <i class="bi bi-plus-lg"></i> Add Student
    </a>
  </div>
</div>




<!-- We remove the manual search form since DataTables provides it dynamically -->

<% if (students.length === 0) { %>
  <div class="text-center py-5" data-testid="text-empty-state">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-muted mb-3" viewBox="0 0 16 16"><path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-.25.006-.868.44-1.72A6.3 6.3 0 0 1 6.936 9.28M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/></svg>
    <p class="text-muted">No students found</p>
    <a href="/admin/students/create" class="btn btn-primary btn-sm">Add First Student</a>
  </div>
<% } else { %>

  <div class="d-none d-md-block">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="table-responsive">
          <table id="studentsTable" class="table table-hover table-sm align-middle w-100" data-testid="table-students">
            <thead class="table-light">
          <tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Nickname</th>
            <th>PC Class</th>
            <th>MAG Class</th>
            <th>PC Teacher</th>
            <th>Email</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(s => { %>
          <tr data-testid="row-student-<%= s.StudentID %>">
            <td><code><%= s.StudentID %></code></td>
            <td><%= s.StudentName %></td>
            <td><%= s.SNickname || '-' %></td>
            <td><%= s.PCClass || '-' %></td>
            <td><%= s.MAGClass || '-' %></td>
            <td><%= s.TeacherName || '-' %> <% if (s.TeacherID) { %><small class="text-muted">(<%= s.TeacherID %>)</small><% } %></td>
            <td><%= s.Email || '-' %></td>
            <td class="text-end text-nowrap">
              <a href="/admin/students/edit/<%= s.StudentID %>" class="btn btn-outline-primary btn-sm" data-testid="button-edit-<%= s.StudentID %>">Edit</a>
              <form method="POST" action="/admin/students/delete/<%= s.StudentID %>" class="d-inline" data-confirm="Delete student <%= s.StudentID %>?" data-confirm-danger="true" data-confirm-btn="Delete">
                <button type="submit" class="btn btn-outline-danger btn-sm" data-testid="button-delete-<%= s.StudentID %>">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
        </div>
      </div>
    </div>
  </div>

  <div class="d-md-none">
    <% students.forEach(s => { %>
    <div class="card mb-2" data-testid="card-student-<%= s.StudentID %>">
      <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong><%= s.StudentName %></strong>
            <% if (s.SNickname) { %><small class="text-muted">(<%= s.SNickname %>)</small><% } %>
            <div class="small text-muted">ID: <code><%= s.StudentID %></code></div>
            <% if (s.PCClass) { %><span class="badge bg-light text-dark border me-1"><%= s.PCClass %></span><% } %>
            <% if (s.MAGClass) { %><span class="badge bg-light text-dark border"><%= s.MAGClass %></span><% } %>
            <% if (s.TeacherName) { %><div class="small mt-1">Teacher: <%= s.TeacherName %></div><% } %>
            <% if (s.Email) { %><div class="small text-muted"><%= s.Email %></div><% } %>
          </div>
          <div class="d-flex flex-column gap-1">
            <a href="/admin/students/edit/<%= s.StudentID %>" class="btn btn-outline-primary btn-sm" data-testid="button-edit-mobile-<%= s.StudentID %>">Edit</a>
            <form method="POST" action="/admin/students/delete/<%= s.StudentID %>" data-confirm="Delete student <%= s.StudentID %>?" data-confirm-danger="true" data-confirm-btn="Delete">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100" data-testid="button-delete-mobile-<%= s.StudentID %>">Delete</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

<% } %>

<!-- DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
  $(document).ready(function() {
    $('#studentsTable').DataTable({
      pageLength: 20,
      lengthMenu: [10, 20, 50, 100],
      pagingType: 'full',
      language: {
        search: "",
        searchPlaceholder: "Search students...",
        lengthMenu: "Rows per page: _MENU_",
        info: "_START_-_END_ of _TOTAL_",
        paginate: {
          first: '<i class="bi bi-chevron-bar-left"></i>',
          previous: '<i class="bi bi-chevron-left"></i>',
          next: '<i class="bi bi-chevron-right"></i>',
          last: '<i class="bi bi-chevron-bar-right"></i>'
        }
      },
      dom: "<'row mb-3'<'col-sm-12 col-md-6'><'col-sm-12 col-md-6'f>>" +
           "<'row'<'col-sm-12'tr>>" +
           "<'row mt-3 align-items-center'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-4 text-center'i><'col-sm-12 col-md-4 d-flex justify-content-end'p>>",
      columnDefs: [
        { orderable: false, targets: -1 } // Disable sorting on actions column
      ]
    });
  });
</script>
