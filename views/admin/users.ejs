<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0" data-testid="text-page-title">Admin Users</h1>
  <a href="/admin/users/create" class="btn btn-primary btn-sm" data-testid="link-create-user">
    <i class="bi bi-plus-lg me-1"></i>Add Admin
  </a>
</div>





<div class="card shadow-sm">
  <div class="table-responsive">
    <table id="usersTable" class="table table-hover mb-0 w-100" data-testid="table-users">
      <thead class="table-light">
        <tr>
          <th>Username</th>
          <th>Name</th>
          <th>Role</th>
          <th>Status</th>
          <th>Created</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4" data-testid="text-no-users">No admin users found.</td>
          </tr>
        <% } else { %>
          <% users.forEach(u => { %>
            <tr data-testid="row-user-<%= u.AdminID %>">
              <td>
                <strong data-testid="text-username-<%= u.AdminID %>"><%= u.Username %></strong>
              </td>
              <td data-testid="text-name-<%= u.AdminID %>"><%= u.FirstName %> <%= u.LastName %></td>
              <td>
                <% if (u.Role === 'SUPER_ADMIN') { %>
                  <span class="badge bg-warning text-dark" data-testid="badge-role-<%= u.AdminID %>">Super Admin</span>
                <% } else { %>
                  <span class="badge bg-info text-dark" data-testid="badge-role-<%= u.AdminID %>">Admin</span>
                <% } %>
              </td>
              <td>
                <% if (u.IsActive) { %>
                  <span class="badge bg-success" data-testid="badge-status-<%= u.AdminID %>">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary" data-testid="badge-status-<%= u.AdminID %>">Inactive</span>
                <% } %>
              </td>
              <td class="small text-muted"><%= u.CreatedAt ? new Date(u.CreatedAt).toLocaleDateString() : '—' %></td>
              <td class="text-end">
                <a href="/admin/users/edit/<%= u.AdminID %>" class="btn btn-outline-primary btn-sm" data-testid="button-edit-<%= u.AdminID %>">Edit</a>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
  $(document).ready(function() {
    if ($('#usersTable').length) {
      $('#usersTable').DataTable({
        pageLength: 20,
        lengthMenu: [10, 20, 50, 100],
        pagingType: 'full',
        language: {
          search: "",
          searchPlaceholder: "Search users...",
          lengthMenu: "Rows per page: _MENU_",
          info: "_START_-_END_ of _TOTAL_",
          paginate: {
            first: '<i class="bi bi-chevron-bar-left"></i>',
            previous: '<i class="bi bi-chevron-left"></i>',
            next: '<i class="bi bi-chevron-right"></i>',
            last: '<i class="bi bi-chevron-bar-right"></i>'
          }
        },
        dom: "<'row mb-3'<'col-sm-12 col-md-6'><'col-sm-12 col-md-6'f>>" +
             "<'row'<'col-sm-12'tr>>" +
             "<'row mt-3 align-items-center'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-4 text-center'i><'col-sm-12 col-md-4 d-flex justify-content-end'p>>",
        columnDefs: [
          { orderable: false, targets: -1 }
        ]
      });
    }
  });
</script>
