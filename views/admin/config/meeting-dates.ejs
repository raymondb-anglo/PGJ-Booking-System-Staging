<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h1 class="h3 mb-0" data-testid="text-page-title">Meeting Dates</h1>
  <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm" data-testid="link-back">Back to Dashboard</a>
</div>




<% if (terms.length === 0) { %>
  <div class="alert alert-warning">No booking terms found. Please <a href="/admin/config/school-year">create a school year and term</a> first.</div>
<% } else { %>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="GET" action="/admin/config/meeting-dates" class="row g-2 align-items-end">
      <div class="col-12 col-sm-8">
        <label for="termId" class="form-label small">Select Term</label>
        <select name="termId" id="termId" class="form-select form-select-sm" data-testid="select-term">
          <% terms.forEach(t => { %>
            <option value="<%= t.TermID %>" <%= selectedTermId === t.TermID ? 'selected' : '' %>>
              <%= t.YearLabel %> — <%= t.TermLabel %><%= t.IsActive ? ' (Active)' : '' %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-sm-4">
        <button type="submit" class="btn btn-outline-primary btn-sm w-100" data-testid="button-select-term">Load Dates</button>
      </div>
    </form>
  </div>
</div>

<% if (selectedTermId) { %>

<div class="card shadow-sm mb-4">
  <div class="card-header"><h6 class="mb-0">Add Meeting Date</h6></div>
  <div class="card-body">
    <form method="POST" action="/admin/config/meeting-dates/create" data-testid="form-create-date">
      <input type="hidden" name="termId" value="<%= selectedTermId %>">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-sm-4">
          <label for="meetingDate" class="form-label small">Meeting Date</label>
          <input type="date" id="meetingDate" name="meetingDate" class="form-control form-control-sm" required data-testid="input-meeting-date">
        </div>
        <div class="col-6 col-sm-3">
          <label for="dayNumber" class="form-label small">Day Number</label>
          <select id="dayNumber" name="dayNumber" class="form-select form-select-sm" required data-testid="select-day-number">
            <% for (let i = 1; i <= 10; i++) { %>
              <option value="<%= i %>">Day <%= i %> (Prefix <%= String.fromCharCode(64+i) %>)</option>
            <% } %>
          </select>
        </div>
        <div class="col-6 col-sm-3">
          <div class="p-2 bg-light rounded text-center small" id="prefixPreview" data-testid="text-prefix-preview">
            Prefix: <strong>A</strong>
          </div>
        </div>
        <div class="col-12 col-sm-2">
          <button type="submit" class="btn btn-primary btn-sm w-100" data-testid="button-create-date">Add</button>
        </div>
      </div>
    </form>
  </div>
</div>

<% if (meetingDates.length === 0) { %>
  <div class="text-center py-5" data-testid="text-empty-state">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-muted mb-3" viewBox="0 0 16 16"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z"/></svg>
    <p class="text-muted">No meeting dates added yet for this term</p>
  </div>
<% } else { %>

  <div class="text-muted small mb-2" data-testid="text-date-count"><%= meetingDates.length %> meeting date<%= meetingDates.length !== 1 ? 's' : '' %></div>

  <div class="d-none d-md-block">
    <div class="table-responsive">
      <table class="table table-hover table-sm align-middle" data-testid="table-meeting-dates">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Day</th>
            <th>Prefix</th>
            <th>Time Slots</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% meetingDates.forEach(md => {
            const dateObj = new Date(md.MeetingDate);
            const dateStr = dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
            const isoDate = dateObj.toISOString().split('T')[0];
          %>
          <tr data-testid="row-date-<%= md.DateID %>">
            <td><%= dateStr %></td>
            <td><span class="badge bg-primary"><%= md.DayLabel || '-' %></span></td>
            <td><code class="fs-6"><%= md.prefix %></code></td>
            <td>
              <% if (md.slotCount > 0) { %>
                <a href="/admin/config/meeting-dates/slots/<%= md.DateID %>" class="text-decoration-none" data-testid="link-slots-<%= md.DateID %>">
                  <%= md.slotCount %> slot<%= md.slotCount !== 1 ? 's' : '' %>
                  <% if (md.blockedCount > 0) { %><span class="text-warning">(<%= md.blockedCount %> blocked)</span><% } %>
                </a>
              <% } else { %>
                <a href="/admin/config/meeting-dates/slots/<%= md.DateID %>" class="btn btn-outline-success btn-sm" data-testid="link-setup-slots-<%= md.DateID %>">Setup Slots</a>
              <% } %>
            </td>
            <td><span class="badge <%= md.IsActive ? 'bg-success' : 'bg-secondary' %>"><%= md.IsActive ? 'Active' : 'Inactive' %></span></td>
            <td class="text-end text-nowrap">
              <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= md.DateID %>" data-testid="button-edit-<%= md.DateID %>">Edit</button>
              <% if (md.slotCount > 0) { %>
                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#dupModal<%= md.DateID %>" data-testid="button-duplicate-<%= md.DateID %>">Duplicate</button>
              <% } %>
              <form method="POST" action="/admin/config/meeting-dates/delete" class="d-inline" data-confirm="Delete this meeting date and all its time slots?" data-confirm-danger="true" data-confirm-btn="Delete">
                <input type="hidden" name="dateId" value="<%= md.DateID %>">
                <input type="hidden" name="termId" value="<%= selectedTermId %>">
                <button type="submit" class="btn btn-outline-danger btn-sm" data-testid="button-delete-<%= md.DateID %>">Delete</button>
              </form>
            </td>
          </tr>

          <div class="modal fade" id="editModal<%= md.DateID %>" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <form method="POST" action="/admin/config/meeting-dates/edit" data-testid="form-edit-date-<%= md.DateID %>">
                  <input type="hidden" name="dateId" value="<%= md.DateID %>">
                  <input type="hidden" name="termId" value="<%= selectedTermId %>">
                  <div class="modal-header"><h5 class="modal-title">Edit Meeting Date</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                  <div class="modal-body">
                    <div class="mb-3">
                      <label class="form-label">Meeting Date</label>
                      <input type="date" name="meetingDate" class="form-control" value="<%= isoDate %>" required data-testid="input-edit-date-<%= md.DateID %>">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Day Number</label>
                      <select name="dayNumber" class="form-select" required data-testid="select-edit-day-<%= md.DateID %>">
                        <% for (let i = 1; i <= 10; i++) { %>
                          <option value="<%= i %>" <%= md.DayNumber === i ? 'selected' : '' %>>Day <%= i %> (Prefix <%= String.fromCharCode(64+i) %>)</option>
                        <% } %>
                      </select>
                    </div>
                    <% if (md.slotCount > 0) { %>
                      <div class="alert alert-warning small mb-0">This date has <%= md.slotCount %> time slots. Changing the day number will be blocked.</div>
                    <% } %>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" data-testid="button-save-edit-<%= md.DateID %>">Save</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <% if (md.slotCount > 0) { %>
          <div class="modal fade" id="dupModal<%= md.DateID %>" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <form method="POST" action="/admin/config/meeting-dates/duplicate" data-testid="form-duplicate-<%= md.DateID %>">
                  <input type="hidden" name="sourceDateId" value="<%= md.DateID %>">
                  <input type="hidden" name="termId" value="<%= selectedTermId %>">
                  <div class="modal-header"><h5 class="modal-title">Duplicate "<%= md.DayLabel %>"</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                  <div class="modal-body">
                    <div class="alert alert-info small">
                      This will copy all time ranges, blocked ranges, and <%= md.slotCount %> time slots to a new meeting day.
                    </div>
                    <div class="mb-3">
                      <label class="form-label">New Meeting Date</label>
                      <input type="date" name="meetingDate" class="form-control" required data-testid="input-dup-date-<%= md.DateID %>">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">New Day Number</label>
                      <select name="dayNumber" class="form-select" required data-testid="select-dup-day-<%= md.DateID %>">
                        <% for (let i = 1; i <= 10; i++) { %>
                          <option value="<%= i %>">Day <%= i %> (Prefix <%= String.fromCharCode(64+i) %>)</option>
                        <% } %>
                      </select>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info btn-sm" data-testid="button-confirm-dup-<%= md.DateID %>">Duplicate</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-md-none">
    <% meetingDates.forEach(md => {
      const dateObj = new Date(md.MeetingDate);
      const dateStr = dateObj.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
      const isoDate = dateObj.toISOString().split('T')[0];
    %>
    <div class="card mb-2" data-testid="card-date-<%= md.DateID %>">
      <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong><%= dateStr %></strong>
            <div class="mt-1">
              <span class="badge bg-primary me-1"><%= md.DayLabel %></span>
              <span class="badge bg-light text-dark border">Prefix: <%= md.prefix %></span>
            </div>
            <div class="small mt-1">
              <% if (md.slotCount > 0) { %>
                <a href="/admin/config/meeting-dates/slots/<%= md.DateID %>"><%= md.slotCount %> slots
                  <% if (md.blockedCount > 0) { %>(<%= md.blockedCount %> blocked)<% } %>
                </a>
              <% } else { %>
                <a href="/admin/config/meeting-dates/slots/<%= md.DateID %>" class="text-success">Setup Slots</a>
              <% } %>
            </div>
          </div>
          <div class="d-flex flex-column gap-1">
            <a href="/admin/config/meeting-dates/slots/<%= md.DateID %>" class="btn btn-outline-success btn-sm">Slots</a>
            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= md.DateID %>">Edit</button>
            <% if (md.slotCount > 0) { %>
              <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#dupModal<%= md.DateID %>">Dup</button>
            <% } %>
            <form method="POST" action="/admin/config/meeting-dates/delete" data-confirm="Delete this date?" data-confirm-danger="true" data-confirm-btn="Delete">
              <input type="hidden" name="dateId" value="<%= md.DateID %>">
              <input type="hidden" name="termId" value="<%= selectedTermId %>">
              <button type="submit" class="btn btn-outline-danger btn-sm w-100">Del</button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

<% } %>
<% } %>
<% } %>

<script>
  var daySelect = document.getElementById('dayNumber');
  var prefixPreview = document.getElementById('prefixPreview');
  if (daySelect && prefixPreview) {
    daySelect.addEventListener('change', function() {
      var prefix = String.fromCharCode(64 + parseInt(this.value));
      prefixPreview.innerHTML = 'Prefix: <strong>' + prefix + '</strong>';
    });
  }
</script>
