<a href="/admin/dashboard" class="text-decoration-none text-muted small">&larr; Back to Dashboard</a>
<h1 class="h3 mt-1 mb-4">School Year & Booking Terms</h1>




<div class="row g-4">
  <!-- School Years -->
  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white fw-semibold">School Years</div>
      <div class="card-body">
        <form method="POST" action="/admin/config/school-year/create" class="mb-3">
          <div class="input-group">
            <input type="text" name="yearLabel" class="form-control" placeholder="e.g. 2025-2026" required>
            <button type="submit" class="btn btn-primary">Add Year</button>
          </div>
        </form>

        <% if (years.length === 0) { %>
          <p class="text-muted">No school years configured yet.</p>
        <% } else { %>
          <div class="list-group">
            <% years.forEach(function(y) { %>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <strong><%= y.YearLabel %></strong>
                  <% if (y.IsActive) { %>
                    <span class="badge bg-success ms-2">Active</span>
                  <% } %>
                </div>
                <div class="d-flex gap-1">
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="button-edit-year-<%= y.SchoolYearID %>" onclick="editYear(<%= y.SchoolYearID %>, '<%= y.YearLabel.replace(/'/g, "\\'") %>')">Edit</button>
                  <% if (!y.IsActive) { %>
                    <form method="POST" action="/admin/config/school-year/activate">
                      <input type="hidden" name="schoolYearId" value="<%= y.SchoolYearID %>">
                      <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                    </form>
                    <form method="POST" action="/admin/config/school-year/delete" data-confirm="Are you sure you want to delete this school year and all its terms? This cannot be undone." data-confirm-danger="true" data-confirm-btn="Delete">
                      <input type="hidden" name="schoolYearId" value="<%= y.SchoolYearID %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" data-testid="button-delete-year-<%= y.SchoolYearID %>">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Booking Terms -->
  <div class="col-lg-6">
    <div class="card shadow-sm">
      <div class="card-header bg-white fw-semibold">Booking Terms</div>
      <div class="card-body">
        <% if (years.length === 0) { %>
          <p class="text-muted">Create a school year first before adding terms.</p>
        <% } else { %>
          <form method="POST" action="/admin/config/term/create" class="mb-3">
            <div class="row g-2">
              <div class="col-5">
                <select name="schoolYearId" class="form-select" required>
                  <option value="">Year...</option>
                  <% years.forEach(function(y) { %>
                    <option value="<%= y.SchoolYearID %>"><%= y.YearLabel %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-4">
                <input type="text" name="termLabel" class="form-control" placeholder="e.g. PGJ1" required>
              </div>
              <div class="col-3">
                <button type="submit" class="btn btn-primary w-100">Add</button>
              </div>
            </div>
          </form>

          <% if (terms.length === 0) { %>
            <p class="text-muted">No terms configured yet.</p>
          <% } else { %>
            <div class="list-group">
              <% terms.forEach(function(t) { %>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <strong><%= t.TermLabel %></strong>
                    <small class="text-muted ms-1">(<%= t.YearLabel %>)</small>
                    <% if (t.IsActive) { %>
                      <span class="badge bg-success ms-2">Active</span>
                    <% } %>
                  </div>
                  <div class="d-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="button-edit-term-<%= t.TermID %>" onclick="editTerm(<%= t.TermID %>, '<%= t.TermLabel.replace(/'/g, "\\'") %>', <%= t.SchoolYearID %>)">Edit</button>
                    <% if (!t.IsActive) { %>
                      <form method="POST" action="/admin/config/term/activate">
                        <input type="hidden" name="termId" value="<%= t.TermID %>">
                        <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                      </form>
                      <form method="POST" action="/admin/config/term/delete" data-confirm="Are you sure you want to delete this booking term? This cannot be undone." data-confirm-danger="true" data-confirm-btn="Delete">
                        <input type="hidden" name="termId" value="<%= t.TermID %>">
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-testid="button-delete-term-<%= t.TermID %>">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="editYearModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form method="POST" action="/admin/config/school-year/edit">
        <div class="modal-header">
          <h6 class="modal-title">Edit School Year</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="schoolYearId" id="editYearId">
          <label class="form-label fw-semibold">Year Label</label>
          <input type="text" name="yearLabel" id="editYearLabel" class="form-control" required data-testid="input-edit-year-label">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" data-testid="button-save-year">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editTermModal" tabindex="-1">
  <div class="modal-dialog modal-sm">
    <div class="modal-content">
      <form method="POST" action="/admin/config/term/edit">
        <div class="modal-header">
          <h6 class="modal-title">Edit Booking Term</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="termId" id="editTermId">
          <div class="mb-3">
            <label class="form-label fw-semibold">Term Label</label>
            <input type="text" name="termLabel" id="editTermLabel" class="form-control" required data-testid="input-edit-term-label">
          </div>
          <div>
            <label class="form-label fw-semibold">School Year</label>
            <select name="schoolYearId" id="editTermYear" class="form-select" data-testid="select-edit-term-year">
              <% years.forEach(function(y) { %>
                <option value="<%= y.SchoolYearID %>"><%= y.YearLabel %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm" data-testid="button-save-term">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function editYear(id, label) {
  document.getElementById('editYearId').value = id;
  document.getElementById('editYearLabel').value = label;
  new bootstrap.Modal(document.getElementById('editYearModal')).show();
}
function editTerm(id, label, yearId) {
  document.getElementById('editTermId').value = id;
  document.getElementById('editTermLabel').value = label;
  document.getElementById('editTermYear').value = yearId;
  new bootstrap.Modal(document.getElementById('editTermModal')).show();
}
</script>
