<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0" data-testid="text-page-title">PDF Template Builder</h1>
  <% if (canEdit) { %>
    <a href="/admin/pdf-template/create" class="btn btn-primary btn-sm" data-testid="button-create-template">+ New Template</a>
  <% } %>
</div>





<div class="alert alert-info small mb-4" data-testid="text-placeholder-info">
  <strong>Available Placeholders:</strong>
  <code>{{student_name}}</code> <code>{{student_id}}</code> <code>{{pc_class}}</code>
  <code>{{teacher_name}}</code> <code>{{meeting_date}}</code> <code>{{meeting_time}}</code>
  <code>{{room}}</code> <code>{{translator}}</code>
</div>

<% if (templates.length === 0) { %>
  <div class="alert alert-warning">No templates found. Create one to get started.</div>
<% } else { %>
  <div class="row g-3">
    <% templates.forEach(function(t) { %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card shadow-sm h-100 <%= t.IsActive ? 'border-success border-2' : '' %>">
          <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold" data-testid="text-template-name-<%= t.TemplateID %>">
              Template #<%= t.TemplateID %>
            </span>
            <% if (t.IsActive) { %>
              <span class="badge bg-success" data-testid="badge-active-<%= t.TemplateID %>">Active</span>
            <% } else { %>
              <span class="badge bg-secondary">Inactive</span>
            <% } %>
          </div>
          <div class="card-body">
            <% if (t.HeaderImage) { %>
              <div class="mb-2">
                <img src="<%= t.HeaderImage %>" alt="Header" class="img-fluid rounded" style="max-height:60px;">
              </div>
            <% } %>
            <% if (t.HeaderText) { %>
              <div class="fw-semibold small mb-1"><%= t.HeaderText %></div>
            <% } %>
            <% if (t.SubHeaderText) { %>
              <div class="small text-muted fst-italic mb-1"><%= t.SubHeaderText %></div>
            <% } %>
            <% if (t.BodyText) { %>
              <div class="small text-muted text-truncate-3" style="max-height:80px;overflow:hidden;">
                <%= t.BodyText.substring(0, 150) %><%= t.BodyText.length > 150 ? '...' : '' %>
              </div>
            <% } %>
            <% if (t.FooterText) { %>
              <div class="small text-muted mt-1 fst-italic"><%= t.FooterText.substring(0, 80) %></div>
            <% } %>
          </div>
          <div class="card-footer bg-white">
            <div class="d-flex gap-1 flex-wrap">
              <a href="/admin/pdf-template/preview/<%= t.TemplateID %>" target="_blank" class="btn btn-outline-info btn-sm" data-testid="button-preview-<%= t.TemplateID %>">Preview</a>
              <% if (canEdit) { %>
                <a href="/admin/pdf-template/edit/<%= t.TemplateID %>" class="btn btn-outline-primary btn-sm" data-testid="button-edit-<%= t.TemplateID %>">Edit</a>
                <% if (!t.IsActive) { %>
                  <form method="POST" action="/admin/pdf-template/activate/<%= t.TemplateID %>" class="d-inline">
                    <button type="submit" class="btn btn-outline-success btn-sm" data-testid="button-activate-<%= t.TemplateID %>">Activate</button>
                  </form>
                  <form method="POST" action="/admin/pdf-template/delete/<%= t.TemplateID %>" class="d-inline" data-confirm="Delete this template?" data-confirm-danger="true" data-confirm-btn="Delete">
                    <button type="submit" class="btn btn-outline-danger btn-sm" data-testid="button-delete-<%= t.TemplateID %>">Delete</button>
                  </form>
                <% } %>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>


