<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <h1 class="h3 mb-0 text-dark fw-bold" data-testid="text-page-title">Teachers</h1>
  <div class="d-flex gap-2">
    <a href="/admin/teachers/import" class="btn btn-outline-secondary d-flex align-items-center gap-2" data-testid="link-import-teachers">
      <i class="bi bi-file-earmark-arrow-up"></i> Import CSV
    </a>
    <a href="/admin/teachers/create" class="btn btn-primary d-flex align-items-center gap-2" data-testid="link-create-teacher">
      <i class="bi bi-plus-lg"></i> Add Teacher
    </a>
  </div>
</div>




<!-- Manual search form removed. DataTables provides search. -->

<% if (teachers.length === 0) { %>
  <div class="text-center py-5" data-testid="text-empty-state">
    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-muted mb-3" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg>
    <p class="text-muted">No teachers added yet</p>
    <a href="/admin/teachers/create" class="btn btn-primary btn-sm">Add First Teacher</a>
  </div>
<% } else { %>

  <div class="d-none d-md-block">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <div class="table-responsive">
          <table id="teachersTable" class="table table-hover table-sm align-middle w-100" data-testid="table-teachers">
            <thead class="table-light">
          <tr>
            <th style="width:50px">Photo</th>
            <th>Code</th>
            <th>Name</th>
            <th>Nickname</th>
            <th>Email</th>
            <th>Room</th>
            <th>Meeting Days</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% teachers.forEach(t => { %>
          <tr class="<%= t.IsActive ? '' : 'table-secondary' %>" data-testid="row-teacher-<%= t.TeacherCode %>">
            <td>
              <% if (t.TeacherImage) { %>
                <img src="<%= t.TeacherImage %>" alt="" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" data-testid="img-teacher-<%= t.TeacherCode %>">
              <% } else { %>
                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4"/></svg>
                </div>
              <% } %>
            </td>
            <td><code><%= t.TeacherCode %></code></td>
            <td><%= t.TeacherName %></td>
            <td><%= t.TeacherNickname %></td>
            <td><%= t.Email || '-' %></td>
            <td><%= t.Room || '-' %></td>
            <td>
              <% if (t.MeetingDays) { %>
                <% t.MeetingDays.split(',').forEach(function(d) { %><span class="badge bg-info me-1">Day <%= d.trim() %></span><% }); %>
              <% } else { %>
                <span class="text-muted">All</span>
              <% } %>
            </td>
            <td>
              <span class="badge <%= t.IsActive ? 'bg-success' : 'bg-secondary' %>" data-testid="badge-status-<%= t.TeacherCode %>"><%= t.IsActive ? 'Active' : 'Inactive' %></span>
            </td>
            <td class="text-end text-nowrap">
              <a href="/admin/teachers/edit/<%= t.TeacherCode %>" class="btn btn-outline-primary btn-sm" data-testid="button-edit-<%= t.TeacherCode %>">Edit</a>
              <form method="POST" action="/admin/teachers/toggle/<%= t.TeacherCode %>" class="d-inline" data-confirm="<%= t.IsActive ? 'Deactivate' : 'Activate' %> teacher <%= t.TeacherCode %>?" data-confirm-btn="<%= t.IsActive ? 'Deactivate' : 'Activate' %>" <%= t.IsActive ? 'data-confirm-danger="true"' : '' %>>
                <button type="submit" class="btn btn-outline-<%= t.IsActive ? 'warning' : 'success' %> btn-sm" data-testid="button-toggle-<%= t.TeacherCode %>"><%= t.IsActive ? 'Deactivate' : 'Activate' %></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
        </div>
      </div>
    </div>
  </div>

  <div class="d-md-none">
    <% teachers.forEach(t => { %>
    <div class="card mb-2 <%= t.IsActive ? '' : 'border-secondary' %>" data-testid="card-teacher-<%= t.TeacherCode %>">
      <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-start">
          <div class="d-flex gap-2 align-items-start">
            <% if (t.TeacherImage) { %>
              <img src="<%= t.TeacherImage %>" alt="" class="rounded-circle flex-shrink-0" style="width:40px;height:40px;object-fit:cover;">
            <% } else { %>
              <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4"/></svg>
              </div>
            <% } %>
            <div>
              <strong><%= t.TeacherName %></strong> <small class="text-muted">(<%= t.TeacherNickname %>)</small>
              <div class="small text-muted">Code: <code><%= t.TeacherCode %></code></div>
              <% if (t.Email) { %><div class="small text-muted"><%= t.Email %></div><% } %>
              <% if (t.Room) { %><div class="small">Room: <%= t.Room %></div><% } %>
              <% if (t.MeetingDays) { %><div class="small mt-1">Days: <% t.MeetingDays.split(',').forEach(function(d) { %><span class="badge bg-info me-1">Day <%= d.trim() %></span><% }); %></div><% } %>
              <span class="badge <%= t.IsActive ? 'bg-success' : 'bg-secondary' %> mt-1"><%= t.IsActive ? 'Active' : 'Inactive' %></span>
            </div>
          </div>
          <div class="d-flex flex-column gap-1">
            <a href="/admin/teachers/edit/<%= t.TeacherCode %>" class="btn btn-outline-primary btn-sm">Edit</a>
            <form method="POST" action="/admin/teachers/toggle/<%= t.TeacherCode %>" data-confirm="<%= t.IsActive ? 'Deactivate' : 'Activate' %> teacher?" data-confirm-btn="<%= t.IsActive ? 'Deactivate' : 'Activate' %>" <%= t.IsActive ? 'data-confirm-danger="true"' : '' %>>
              <button type="submit" class="btn btn-outline-<%= t.IsActive ? 'warning' : 'success' %> btn-sm w-100"><%= t.IsActive ? 'Deactivate' : 'Activate' %></button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

<% } %>

<!-- DataTables JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
  $(document).ready(function() {
    $('#teachersTable').DataTable({
      pageLength: 20,
      lengthMenu: [10, 20, 50, 100],
      pagingType: 'full',
      language: {
        search: "",
        searchPlaceholder: "Search teachers...",
        lengthMenu: "Rows per page: _MENU_",
        info: "_START_-_END_ of _TOTAL_",
        paginate: {
          first: '<i class="bi bi-chevron-bar-left"></i>',
          previous: '<i class="bi bi-chevron-left"></i>',
          next: '<i class="bi bi-chevron-right"></i>',
          last: '<i class="bi bi-chevron-bar-right"></i>'
        }
      },
      dom: "<'row mb-3'<'col-sm-12 col-md-6'><'col-sm-12 col-md-6'f>>" +
           "<'row'<'col-sm-12'tr>>" +
           "<'row mt-3 align-items-center'<'col-sm-12 col-md-4'l><'col-sm-12 col-md-4 text-center'i><'col-sm-12 col-md-4 d-flex justify-content-end'p>>",
      columnDefs: [
        { orderable: false, targets: 0 }, // Photo
        { orderable: false, targets: -1 } // Actions
      ]
    });
  });
</script>
