<div class="row justify-content-center mt-5">
  <div class="col-11 col-md-6">
    <div class="card shadow-sm border-danger">
      <div class="card-body text-center p-5">
        <h1 class="h3 text-danger mb-3" data-testid="text-forbidden-title">Access Denied</h1>
        <p class="text-muted mb-4" data-testid="text-forbidden-message"><%= message %></p>
        <a href="/admin/dashboard" class="btn btn-primary" data-testid="link-back-dashboard">Back to Dashboard</a>
      </div>
    </div>
  </div>
</div>
