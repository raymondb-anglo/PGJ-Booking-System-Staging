<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 data-testid="text-page-title">Book on Behalf of Student</h3>
  <a href="/admin/bookings" class="btn btn-outline-secondary btn-sm" data-testid="link-back-bookings">← Back to Bookings</a>
</div>


<div class="card shadow-sm mb-4">
  <div class="card-header bg-light">
    <h6 class="mb-0">Step 1: Select Student & Meeting Date</h6>
  </div>
  <div class="card-body">
    <form method="GET" action="/admin/bookings/book-on-behalf" class="row g-3" data-testid="form-select-student">
      <input type="hidden" name="termId" value="<%= selectedTermId %>">
      <div class="col-md-4">
        <label class="form-label">Student</label>
        <select name="studentId" class="form-select" data-testid="select-student" onchange="this.form.submit()">
          <option value="">— Select Student —</option>
          <% students.forEach(s => { %>
            <option value="<%= s.StudentID %>" <%= selectedStudentId === s.StudentID ? 'selected' : '' %>>
              <%= s.StudentName %> (<%= s.StudentID %>) — <%= s.PCClass %>
            </option>
          <% }) %>
        </select>
      </div>
      <% if (selectedStudent) { %>
        <div class="col-md-4">
          <label class="form-label">Meeting Date</label>
          <select name="dateId" class="form-select" data-testid="select-date" onchange="this.form.submit()">
            <option value="">— Select Date —</option>
            <% meetingDates.forEach(d => { %>
              <option value="<%= d.DateID %>" <%= selectedDateId == d.DateID ? 'selected' : '' %> <%= d.slotCount === 0 ? 'disabled' : '' %>>
                <%= d.DayLabel %> — <%= new Date(d.MeetingDate).toLocaleDateString('en-GB') %><%= d.slotCount === 0 ? ' [No Slots]' : '' %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Assigned Teacher</label>
          <input type="text" class="form-control" readonly
                 value="<%= selectedStudent.TeacherName %><%= selectedStudent.TeacherNickname ? ' (' + selectedStudent.TeacherNickname + ')' : '' %>"
                 data-testid="text-teacher-name">
        </div>
      <% } %>
    </form>
  </div>
</div>

<% if (selectedStudent && selectedDateId && slots.length > 0) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-light">
      <h6 class="mb-0">Step 2: Select Time Slot</h6>
    </div>
    <div class="card-body">
      <form method="POST" action="/admin/bookings/book" id="bookingForm" data-testid="form-book-on-behalf"
            data-confirm="Confirm booking for <%= selectedStudent.StudentName %>?" data-confirm-btn="Confirm Booking">
        <input type="hidden" name="studentId" value="<%= selectedStudent.StudentID %>">
        <input type="hidden" name="teacherCode" value="<%= selectedStudent.TeacherID %>">
        <input type="hidden" name="meetingDateId" value="<%= selectedDateId %>">
        <input type="hidden" name="termId" value="<%= selectedTermId %>">

        <div class="row g-2 mb-3">
          <% let availableCount = 0; %>
          <% slots.forEach(slot => { %>
            <div class="col-6 col-md-4 col-lg-3">
              <div class="card h-100 <%= slot.effectiveStatus === 'available' ? 'border-success' : 'border-secondary' %>"
                   data-testid="slot-card-<%= slot.SlotID %>">
                <div class="card-body p-2 text-center">
                  <strong><%= slot.ScheduleCode %></strong><br>
                  <small><%= slot.StartTime.substring(0,5) %> – <%= slot.EndTime.substring(0,5) %></small><br>
                  <% if (slot.effectiveStatus === 'available') { %>
                    <% availableCount++; %>
                    <div class="form-check mt-1 d-flex justify-content-center">
                      <input class="form-check-input" type="radio" name="slotId" value="<%= slot.SlotID %>"
                             id="slot_<%= slot.SlotID %>" data-testid="radio-slot-<%= slot.SlotID %>">
                    </div>
                    <span class="badge bg-success mt-1">Available</span>
                  <% } else if (slot.effectiveStatus === 'booked') { %>
                    <span class="badge bg-primary mt-1">Booked</span>
                    <small class="d-block text-muted"><%= slot.BookedStudentID %></small>
                  <% } else if (slot.effectiveStatus === 'teacher-blocked') { %>
                    <span class="badge bg-danger mt-1">Teacher Blocked</span>
                  <% } else { %>
                    <span class="badge bg-secondary mt-1">Global Blocked</span>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (availableCount > 0) { %>
          <div class="border-top pt-3">
            <div class="row g-3 align-items-end">
              <div class="col-md-3">
                <label class="form-label">Translator Required?</label>
                <select name="translatorRequired" class="form-select" data-testid="select-translator" id="translatorSelect">
                  <option value="0">No</option>
                  <option value="1">Yes</option>
                </select>
              </div>
              <div class="col-md-4" id="languageField" style="display:none;">
                <label class="form-label">Language</label>
                <input type="text" name="translatorLanguage" class="form-control" placeholder="e.g. Thai, Chinese" data-testid="input-language">
              </div>
              <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100" data-testid="button-submit-booking">
                  Confirm Booking
                </button>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="alert alert-warning mb-0">No available slots for this teacher on this date.</div>
        <% } %>
      </form>
    </div>
  </div>
<% } else if (selectedStudent && selectedDateId) { %>
  <div class="alert alert-warning">No time slots found for this meeting date.</div>
<% } %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sel = document.getElementById('translatorSelect');
    const field = document.getElementById('languageField');
    if (sel && field) {
      sel.addEventListener('change', function() {
        field.style.display = this.value === '1' ? '' : 'none';
      });
    }
  });
</script>
