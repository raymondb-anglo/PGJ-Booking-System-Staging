          <p class="card-text text-muted small mb-0">Manage per-teacher slot availability</p>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/admin/bookings" class="text-decoration-none">
      <div class="card shadow-sm h-100 dashboard-card">
        <div class="card-body text-center py-4">
          <div class="mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="text-primary" viewBox="0 0 16 16"><path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"/><path d="M10.97 4.97a.75.75 0 0 1 1.071 1.05l-3.992 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/></svg></div>
