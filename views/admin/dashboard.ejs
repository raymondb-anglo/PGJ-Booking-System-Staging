        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/admin/translations" class="text-decoration-none" data-testid="link-translations">
      <div class="card shadow-sm h-100 dashboard-card">
        <div class="card-body text-center py-4">
          <div class="mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="text-primary" viewBox="0 0 16 16"><path d="M4.545 6.714 4.11 8H3l1.862-5h1.284L8 8H6.833l-.435-1.286zm1.634-.736L5.5 3.956h-.049l-.679 2.022zM0 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v3h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-3H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zm7.138 9.995c.193.166.53.038.53-.27v-1.12l.016-.015 2.304-2.686c.16-.186-.051-.46-.277-.315L9 9.312v-.7l1.342-.952c.16-.114.13-.375-.054-.403L9 7.027V5h1v2.256l1.758-1.248c.546-.389 1.312.18.993.795l-1.128 1.31 1.039.932c.37.333.005.95-.443.754L11 9.252V11a1 1 0 0 1-1 1z"/></svg></div>
