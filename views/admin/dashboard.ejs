<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0" data-testid="text-page-title">Admin Dashboard</h1>
  <span class="text-muted small" data-testid="text-admin-name">
    Logged in as <strong><%= typeof adminUsername !== 'undefined' ? adminUsername : '' %></strong>
    <% if (typeof adminRole !== 'undefined' && adminRole) { %>
      <span class="badge bg-light text-dark border ms-1"><%= adminRole %></span>
    <% } %>
  </span>
</div>

<% const isSuperAdmin = (typeof adminRole !== 'undefined' && adminRole === 'SUPER_ADMIN'); %>

<h5 class="text-muted mb-3">Data Management</h5>
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <a href="/admin/students" class="text-decoration-none">
      <div class="card shadow-sm h-100 dashboard-card">
        <div class="card-body text-center py-4">
          <div class="mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="text-primary" viewBox="0 0 16 16"><path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-.25.006-.868.44-1.72A6.3 6.3 0 0 1 6.936 9.28M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/></svg></div>
          <h6 class="card-title mb-1">Students</h6>
          <p class="card-text text-muted small mb-0">Manage student records & import</p>
        </div>
      </div>
    </a>
  </div>
  <div class="col-6 col-lg-3">
    <a href="/admin/teachers" class="text-decoration-none">
      <div class="card shadow-sm h-100 dashboard-card">
        <div class="card-body text-center py-4">
          <div class="mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="text-primary" viewBox="0 0 16 16"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/></svg></div>
